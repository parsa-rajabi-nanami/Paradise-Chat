# Copy to .env for local Docker Compose use. Never commit the copy.
DJANGO_ENV=development

DJANGO_SECRET_KEY=generate_a_random_secret_at_least_50_characters_long
JWT_SIGNING_KEY=generate_a_separate_random_secret_at_least_50_characters_long
DJANGO_BASE_URL=http://localhost

# Host binding for the Compose Nginx gateway. Keep loopback when an external
# reverse proxy such as aaPanel owns public ports 80/443.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# PostgreSQL
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=replace_with_a_local_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis: database 0 is Channels; database 1 is Django cache.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Media storage. Keep local for the supplied Compose volume, or select s3 for
# an S3-compatible private bucket (AWS, MinIO, Backblaze, etc.).
MEDIA_STORAGE=local
MEDIA_ROOT=/app/media
USE_NGINX_ACCEL_REDIRECT=True
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Explicit production allow-lists.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
SECURE_SSL_REDIRECT=False
ACCESS_TOKEN_MINUTES=15
DEV_USE_SQLITE=0

# Abuse controls.
LOGIN_THROTTLE_RATE=10/minute
REGISTER_THROTTLE_RATE=5/hour
REFRESH_THROTTLE_RATE=30/hour
UPLOAD_THROTTLE_RATE=60/hour
WS_RATE_LIMIT_WINDOW_SECONDS=10
WS_RATE_LIMIT_MESSAGES=30
WEB_CONCURRENCY=2
DB_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1

# Vite values are consumed at frontend image build time.
VITE_API_URL=/api
# Leave empty for same-origin WebSockets. Set a host:port only when the
# browser-facing WebSocket endpoint is different from the current site.
VITE_WS_HOST=
VITE_SITE_URL=http://127.0.0.1:8080
