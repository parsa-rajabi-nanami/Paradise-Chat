{
  "permissions": {
    "allow": [
      "Edit(/.claude/skills/design-system/**)",
      "Edit(/.claude/skills/tailwind-design-system/**)",
      "Edit(/.claude/skills/django-expert/**)",
      "Bash(bash .claude/setup/verify.sh)",
      "Bash(echo \"EXIT=$?\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/resources/caveman/src/hooks/caveman-activate.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/resources/caveman/src/hooks/caveman-mode-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": false
  }
}
