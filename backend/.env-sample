# Use the root .env.example as the canonical template for Compose deployments.
# This file is for manual backend development only. Never commit a populated copy.
DJANGO_ENV=development
DJANGO_SECRET_KEY=generate_a_random_secret_at_least_50_characters_long
JWT_SIGNING_KEY=generate_a_separate_random_secret_at_least_50_characters_long
DJANGO_BASE_URL=http://127.0.0.1:8000

# Database
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=replace_with_a_local_database_password
DB_HOST=localhost
DB_PORT=5432

# Redis: database 0 is Channels and database 1 is Django cache.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Production media options. For S3-compatible storage set MEDIA_STORAGE=s3
# and provide the bucket/endpoint/credentials through a secret manager.
MEDIA_STORAGE=local
MEDIA_ROOT=/app/media
USE_NGINX_ACCEL_REDIRECT=True
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# These values are required when DJANGO_ENV=production.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Abuse controls for authentication and file-upload mutations.
LOGIN_THROTTLE_RATE=10/minute
REGISTER_THROTTLE_RATE=5/hour
REFRESH_THROTTLE_RATE=30/hour
UPLOAD_THROTTLE_RATE=60/hour
